{
  "name": "oge-rpg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:world-gen": "esbuild scripts/test-world-gen.ts --bundle --platform=node --format=cjs --outfile=.tmp/test-world-gen.cjs && node .tmp/test-world-gen.cjs",
    "test:world-footprint": "esbuild scripts/test-world-footprint.ts --bundle --platform=node --format=cjs --outfile=.tmp/test-world-footprint.cjs && node .tmp/test-world-footprint.cjs",
    "test:chunk-collisions": "esbuild scripts/test-chunk-collisions.ts --bundle --platform=node --format=cjs --external:@babylonjs/core --outfile=.tmp/test-chunk-collisions.cjs && node .tmp/test-chunk-collisions.cjs",
    "test:streaming-window": "esbuild scripts/test-streaming-window.ts --bundle --platform=node --format=cjs --external:@babylonjs/core --outfile=.tmp/test-streaming-window.cjs && node .tmp/test-streaming-window.cjs",
    "test:world-extend": "esbuild scripts/test-world-extend.ts --bundle --platform=node --format=cjs --outfile=.tmp/test-world-extend.cjs && node .tmp/test-world-extend.cjs",
    "test:section-content": "esbuild scripts/test-section-content.ts --bundle --platform=node --format=cjs --outfile=.tmp/test-section-content.cjs && node .tmp/test-section-content.cjs",
    "test:world-streamer": "esbuild scripts/test-world-streamer.ts --bundle --platform=node --format=cjs --external:@babylonjs/core --outfile=.tmp/test-world-streamer.cjs && node .tmp/test-world-streamer.cjs",
    "test:witch-figure": "esbuild scripts/test-witch-figure.ts --bundle --platform=node --format=cjs --external:@babylonjs/core --outfile=.tmp/test-witch-figure.cjs && node .tmp/test-witch-figure.cjs",
    "test:spells": "esbuild scripts/test-spells.ts --bundle --platform=node --format=cjs --outfile=.tmp/test-spells.cjs && node .tmp/test-spells.cjs",
    "test:loot": "esbuild scripts/test-loot.ts --bundle --platform=node --format=cjs --outfile=.tmp/test-loot.cjs && node .tmp/test-loot.cjs",
    "test:chest": "esbuild scripts/test-chest.ts --bundle --platform=node --format=cjs --external:@babylonjs/core --outfile=.tmp/test-chest.cjs && node .tmp/test-chest.cjs",
    "test:loot-ui": "esbuild scripts/test-loot-ui.ts --bundle --platform=node --format=cjs --define:import.meta.env.DEV=false --outfile=.tmp/test-loot-ui.cjs && node .tmp/test-loot-ui.cjs",
    "test:mobile": "esbuild scripts/test-mobile-controls.ts --bundle --platform=node --format=cjs --outfile=.tmp/test-mobile-controls.cjs && node .tmp/test-mobile-controls.cjs",
    "test:quality": "esbuild scripts/test-quality.ts --bundle --platform=node --format=cjs --outfile=.tmp/test-quality.cjs && node .tmp/test-quality.cjs",
    "test:grass": "esbuild scripts/test-grass.ts --bundle --platform=node --format=cjs --external:@babylonjs/core --outfile=.tmp/test-grass.cjs && node .tmp/test-grass.cjs",
    "test:foliage": "esbuild scripts/test-foliage.ts --bundle --platform=node --format=cjs --external:@babylonjs/core --outfile=.tmp/test-foliage.cjs && node .tmp/test-foliage.cjs",
    "test:backpack": "esbuild scripts/test-backpack.ts --bundle --platform=node --format=cjs --external:@babylonjs/core --outfile=.tmp/test-backpack.cjs && node .tmp/test-backpack.cjs",
    "test:loot-present": "esbuild scripts/test-loot-present.ts --bundle --platform=node --format=cjs --external:@babylonjs/core --define:import.meta.env.DEV=false --outfile=.tmp/test-loot-present.cjs && node .tmp/test-loot-present.cjs",
    "test:settings": "esbuild scripts/test-settings.ts --bundle --platform=node --format=cjs --outfile=.tmp/test-settings.cjs && node .tmp/test-settings.cjs",
    "test:keybindings": "esbuild scripts/test-keybindings.ts --bundle --platform=node --format=cjs --outfile=.tmp/test-keybindings.cjs && node .tmp/test-keybindings.cjs",
    "test:apply-settings": "esbuild scripts/test-apply-settings.ts --bundle --platform=node --format=cjs --external:@babylonjs/core --outfile=.tmp/test-apply-settings.cjs && node .tmp/test-apply-settings.cjs",
    "test:pause": "esbuild scripts/test-pause.ts --bundle --platform=node --format=cjs --external:@babylonjs/core --outfile=.tmp/test-pause.cjs && node .tmp/test-pause.cjs",
    "test:save": "esbuild scripts/test-save.ts --bundle --platform=node --format=cjs --external:@babylonjs/core --outfile=.tmp/test-save.cjs && node .tmp/test-save.cjs",
    "test:graph-view": "esbuild scripts/test-graph-view.ts --bundle --platform=node --format=cjs --external:@babylonjs/core --outfile=.tmp/test-graph-view.cjs && node .tmp/test-graph-view.cjs",
    "test:world": "npm run test:world-gen && npm run test:world-footprint && npm run test:chunk-collisions && npm run test:streaming-window && npm run test:world-extend && npm run test:world-streamer",
    "test:combat-model": "esbuild scripts/test-combat-model.ts --bundle --platform=node --format=cjs --outfile=.tmp/test-combat-model.cjs && node .tmp/test-combat-model.cjs",
    "test:combat-flow": "esbuild scripts/test-combat-flow.ts --bundle --platform=node --format=cjs --external:@babylonjs/core --define:import.meta.env.DEV=false --outfile=.tmp/test-combat-flow.cjs && node .tmp/test-combat-flow.cjs",
    "test:battle-stage": "esbuild scripts/test-battle-stage.ts --bundle --platform=node --format=cjs --external:@babylonjs/core --define:import.meta.env.DEV=false --outfile=.tmp/test-battle-stage.cjs && node .tmp/test-battle-stage.cjs",
    "test:witch-ai": "esbuild scripts/test-witch-ai.ts --bundle --platform=node --format=cjs --outfile=.tmp/test-witch-ai.cjs && node .tmp/test-witch-ai.cjs",
    "test:stealth": "esbuild scripts/test-stealth.ts --bundle --platform=node --format=cjs --external:@babylonjs/core --outfile=.tmp/test-stealth.cjs && node .tmp/test-stealth.cjs",
    "test:world:full": "npm run test:world-gen -- --full && npm run test:world-footprint -- --full && npm run test:chunk-collisions -- --full && npm run test:streaming-window -- --full && npm run test:world-extend -- --full && npm run test:world-streamer -- --full",
    "test:fast": "npm run test:combat-model && npm run test:combat-flow && npm run test:battle-stage && npm run test:witch-ai && npm run test:stealth && npm run test:section-content && npm run test:witch-figure && npm run test:chest && npm run test:spells && npm run test:loot && npm run test:loot-ui && npm run test:mobile && npm run test:quality && npm run test:grass && npm run test:foliage && npm run test:backpack && npm run test:loot-present && npm run test:settings && npm run test:keybindings && npm run test:apply-settings && npm run test:graph-view && npm run test:pause && npm run test:save",
    "test": "npm run test:fast && npm run test:world"
  },
  "dependencies": {
    "@babylonjs/core": "^7.35.0"
  },
  "devDependencies": {
    "@babylonjs/inspector": "^7.54.3",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "typescript": "^5.5.4",
    "vite": "^8.3.5"
  }
}
